CompileFlags:
  Add:
  - -Wno-unknown-warning-option
  - -Wno-compare-distinct-pointer-types
  Remove: [-m*, -f*]
FileExtensions:
  - Pattern: "*.c"
    Language: C
  - Pattern: "*.h"
    Language: C
  - Pattern: "*.cpp"
    Language: C++
  - Pattern: "*.hpp"
    Language: C++
Diagnostics:
  MissingIncludes: Strict

  ClangTidy:
    Add:
      - misc-include-cleaner
    FastCheckFilter: None
